# Vercel Postgres — auto-set when you add Postgres storage in Vercel
POSTGRES_URL=postgres://user:password@host/database

# Required for JWT session cookies (use a long random string in production)
# In local development, a dev fallback is used automatically when unset.
AUTH_SECRET=your-secret-at-least-32-characters-long

# Default warehouse admin credentials (change in production!)
ADMIN_EMAIL=admin@store.com
ADMIN_PASSWORD=Admin123!
